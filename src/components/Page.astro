---
// Gabarit d'une page de contenu : colonne centrée sous l'en-tête ; `prose` = colonne de lecture de 780px.
interface Props { variant?: "default" | "prose" }
const { variant = "default" } = Astro.props;
---
<main>
  {variant === "prose" ? <div class="prose"><slot /></div> : <slot />}
</main>
<style>
  main {
    max-width: var(--container-max); margin: 0 auto;
    padding: var(--page-top) var(--container-pad) var(--page-bottom);
  }
  .prose { max-width: 780px; margin: 0 auto; }
</style>
