---
// Retour vers la page parente : une fine flèche, toujours en haut à gauche de la page.
interface Props { href: string; label?: string }
const { href, label } = Astro.props;
---
<a href={href} title={label || "Retour"} aria-label={label || "Retour"} class="back">
  <!-- Flèche dessinée plutôt qu'un chevron « ‹ » : à cette graisse, le glyphe de la serif
       se réduit à une virgule qu'on ne voit plus quand il est seul. -->
  <svg width="26" height="14" viewBox="0 0 26 14" fill="none" stroke="currentColor"
    stroke-width="1.1" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M25 7 H2 M8 1.5 L2 7 L8 12.5" />
  </svg>
  {label}
</a>
<style>
  .back {
    color: var(--fg-muted); font-family: var(--font-body); font-size: 15px; margin-bottom: 28px;
    display: flex; align-items: center; gap: 8px; padding: 4px 0; text-decoration: none;
    width: fit-content; transition: color 0.2s;
  }
  .back:hover { color: var(--fg); }
</style>
