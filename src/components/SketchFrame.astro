---
/* Contour « fait à la main » : quatre traits qui débordent aux coins et fléchissent au milieu.
   Le viewBox 0–100 est étiré sur la carte ; `non-scaling-stroke` garde un trait fin. Le tracé
   dépend de `seed` : une même vignette garde toujours le même dessin. */
import { seededRandom } from "../lib/random";
interface Props { seed?: number; strokeWidth?: number }
const { seed = 1, strokeWidth = 1.3 } = Astro.props;

function sketchPath(seed: number) {
  const r = (k: number, amp: number) => (seededRandom(seed * 13 + k) - 0.5) * 2 * amp;
  const f = (n: number) => n.toFixed(2);
  const side = (k: number, x1: number, y1: number, x2: number, y2: number) => {
    const mx = (x1 + x2) / 2, my = (y1 + y2) / 2;
    return `M${f(x1 + r(k, 0.8))} ${f(y1 + r(k + 1, 0.8))} `
      + `Q${f(mx + r(k + 2, 1.2))} ${f(my + r(k + 3, 1.2))} `
      + `${f(x2 + r(k + 4, 0.8))} ${f(y2 + r(k + 5, 0.8))}`;
  };
  return [
    side(1, -1.2, 0.6, 101, 0),
    side(11, 99.6, -1.5, 100.3, 101.5),
    side(21, 101.2, 99.4, -0.8, 100.2),
    side(31, 0.2, 101.6, -0.3, -1.4),
  ].join(" ");
}
---
<svg viewBox="0 0 100 100" preserveAspectRatio="none" aria-hidden="true"
  style="position:absolute;inset:0;width:100%;height:100%;overflow:visible;pointer-events:none">
  <path d={sketchPath(seed)} fill="none" stroke="var(--fg)" stroke-width={strokeWidth} stroke-linecap="round" vector-effect="non-scaling-stroke" />
  <!-- second passage plus léger : la main repasse rarement exactement sur son trait -->
  <path d={sketchPath(seed + 7)} fill="none" stroke="var(--fg)" stroke-width={strokeWidth * 0.5} stroke-linecap="round" vector-effect="non-scaling-stroke" opacity="0.45" />
</svg>
