---
import "../styles/global.css";
import { getEntry } from "astro:content";
import { ClientRouter } from "astro:transitions";
import { abs } from "../lib/seo";
import { image as manifestImage } from "../lib/images";

interface Props {
  title?: string;
  description?: string;
  /* Chemin canonique de la page (`/`, `/menu`…), résolu contre `site` de astro.config. */
  path?: string;
  lang?: string;
  /* Image de partage (chemin absolu du site, ex. `/assets/…`) ; repli : première photo d'accueil. */
  image?: string;
  /* Données structurées : un objet ou une liste, chacun devient un <script ld+json>. */
  ld?: object | object[];
  /* Versions de la page dans d'autres langues, avec x-default. */
  alternates?: { hreflang: string; path: string }[];
}
const site = (await getEntry("site", "site"))!.data;
const NAME = "Vania Jaikin Miyazaki";
const { title = NAME, description = site.description, path = Astro.url.pathname, lang = "fr", image, ld, alternates } = Astro.props;
const canonical = new URL(path, Astro.site).href;
const photo = (await getEntry("accueil", "accueil"))!.data.photos[0];
const ogImage = abs(image ?? (photo && manifestImage(photo)?.src) ?? "/assets/brand/nom-manuscrit.png");
const lds = [ld ?? []].flat().map((o) => JSON.stringify({ "@context": "https://schema.org", ...o }).replace(/</g, "\\u003c"));

// Newsreader et Manrope servent partout ; la police du menu s'y ajoute si c'en est une autre.
const menuFont = site.policeMenu;
const menuFamily = menuFont === "Manrope" ? "" : `family=${menuFont.replace(/\s+/g, "+")}:wght@300..600&`;
const fonts = `https://fonts.googleapis.com/css2?${menuFamily}family=Manrope:wght@300..600&family=Newsreader:ital,opsz,wght@0,6..72,300..600;1,6..72,300..500&display=swap`;
---
<!doctype html>
<html lang={lang} data-theme="light" style={`--font-menu: '${menuFont}', sans-serif`}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={NAME} />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "fr_CH"} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    {alternates?.map((a) => <link rel="alternate" hreflang={a.hreflang} href={abs(a.path)} />)}
    {lds.map((j) => <script type="application/ld+json" set:html={j} />)}
    <link rel="icon" href="/assets/brand/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/assets/brand/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/assets/brand/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/assets/brand/apple-touch-icon.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href={fonts} rel="stylesheet" />
    <!-- Thème mémorisé, appliqué avant le premier rendu pour éviter l'éclair clair ; le
         stockage peut être indisponible (navigation privée), le thème clair reste le défaut.
         Le ClientRouter recopie les attributs de <html> de la page reçue (data-theme="light") :
         on réapplique après chaque échange, avant l'affichage. -->
    <script is:inline>
      (function () {
        function theme() {
          try {
            if (localStorage.getItem("vjm-theme") === "dark") document.documentElement.dataset.theme = "dark";
          } catch (e) {}
        }
        theme();
        document.addEventListener("astro:after-swap", theme);
      })();
    </script>
    <!-- Avant le routeur (voir src/lib/popup-history.ts) : premier à voir popstate. -->
    <script is:inline>addEventListener("popstate", function (e) { if (window.__vjmPopstate) window.__vjmPopstate(e); });</script>
    <ClientRouter />
    <slot name="head" />
  </head>
  <body>
    <slot />
  </body>
</html>
