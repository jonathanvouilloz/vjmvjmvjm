---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Page from "../../components/Page.astro";
import BackLink from "../../components/BackLink.astro";
import ReadingTile from "../../components/ReadingTile.astro";

// Textes publiés, par `ordre` puis par titre : comme l'ancien build.
const textes = (await getCollection("lecture"))
  .filter((t) => t.data.publie)
  .sort((a, b) => a.data.ordre - b.data.ordre || a.data.titre.localeCompare(b.data.titre));
---
<Base title="Coin lecture — Vania Jaikin Miyazaki" path="/lecture">
  <Header />
  <Page>
    {/* la flèche suffit : pas de libellé, pas de titre */}
    <BackLink href="/menu" />
    <div class="colonnes">
      {textes.map((t, i) => <ReadingTile text={t} index={i} />)}
    </div>
  </Page>
</Base>
<style>
  .colonnes { column-count: 3; column-gap: 56px; padding-top: 8px; }
  @media (max-width: 760px) { .colonnes { column-count: 1; } }
</style>
