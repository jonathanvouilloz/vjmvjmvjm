---
/* Dessin (canvas) + formulaire Netlify. Le vrai formulaire est dans le HTML : Netlify le détecte
   au build, plus de copie statique cachée dans le gabarit. Le script d'envoi reprend l'ancien
   ContactPage (fetch POST multipart vers `/`, dessin joint en PNG). */
import { getEntry } from "astro:content";
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Page from "../components/Page.astro";
import PageTitle from "../components/PageTitle.astro";
import { abs } from "../lib/seo";

const site = (await getEntry("site", "site"))!.data;
const INKS = [
  { id: "ink", css: "var(--fg)", label: "encre" },
  { id: "orange", css: "#FF6B00", label: "orange" },
  { id: "rose", css: "#FF2D95", label: "rose" },
  { id: "vert", css: "#39FF14", label: "vert" },
  { id: "jaune", css: "#FFE800", label: "jaune" },
  { id: "bleu", css: "#00CFFF", label: "bleu" },
];
// Icônes réseaux : contours 1.4, même graisse que les icônes maison.
const ICONS: Record<string, string> = {
  instagram: '<rect x="3" y="3" width="18" height="18" rx="5" /><circle cx="12" cy="12" r="4" /><circle cx="17.2" cy="6.8" r="0.9" fill="currentColor" stroke="none" />',
  facebook: '<path d="M14.5 8.5h2.2M14.5 21V9.6c0-1.7 1-2.6 2.6-2.6h1.4M11 12.6h5.8" /><rect x="3" y="3" width="18" height="18" rx="5" />',
  vimeo: '<rect x="3" y="3" width="18" height="18" rx="5" /><path d="M7 9.4c.8-1 1.6-1.5 2.2-1.3.7.2 1 1.1 1.2 2.3.3 1.9.6 3.4 1.1 3.4.5 0 1.4-1 2.2-2.3.9-1.4 1.3-2.6 1.2-3.3-.1-.9-.8-1.2-1.7-1 .5-1.2 1.6-1.8 2.6-1.6.9.2 1.3 1 1.2 2.2-.2 2-1.8 5-3.5 6.8-1.4 1.5-2.6 1.9-3.4.8-.6-.8-1.2-2.9-1.8-4.9-.3-1-.7-1.4-1.3-1.1z" />',
  spotify: '<circle cx="12" cy="12" r="9" /><path d="M7.2 9.1c3.1-.8 6.4-.5 9.2 1M7.9 12.3c2.5-.6 5.2-.4 7.5.9M8.7 15.4c2-.5 4.1-.3 5.9.7" />',
};
---
<Base title="Contact — Vania Jaikin Miyazaki" path="/contact" ld={{ "@type": "ContactPage", name: "Contact", url: abs("/contact"), inLanguage: "fr" }}>
  <Header />
  <Page variant="bleed">
    <div class="grille">
      <div class="dessin">
        <canvas id="dessin-canvas" aria-label="Zone de dessin"></canvas>
        {/* Barre en haut : toujours au-dessus de la ligne de flottaison, quelle que soit la hauteur de fenêtre. */}
        <div class="barre">
          <div class="encres">
            {INKS.map((c) => (
              <button type="button" data-ink={c.id} title={c.label} aria-label={c.label} style={`background:${c.css}`}
                data-active={c.id === "ink" ? "" : undefined}></button>
            ))}
          </div>
          <button type="button" id="dessin-effacer" class="effacer">effacer</button>
        </div>
      </div>

      <div class="formulaire">
        <div class="colonne">
          <PageTitle id="contact" label="Contact" align="left" />
          <form name="contact" method="POST" enctype="multipart/form-data" data-netlify="true" data-netlify-honeypot="bot-field">
            <input type="hidden" name="form-name" value="contact" />
            <input type="hidden" name="subject" value="Nouveau message depuis vjmvjmvjm.com" />
            <p hidden><label>Ne pas remplir : <input name="bot-field" /></label></p>
            <label>nom<input name="nom" required autocomplete="name" /></label>
            <label>email<input name="email" type="email" required autocomplete="email" /></label>
            <label>message<textarea name="message" rows="5" required></textarea></label>
            <!-- Déclare le champ du dessin à Netlify ; le PNG est joint par le script. -->
            <input type="file" name="dessin" accept="image/png" hidden />
            <button type="submit" class="envoyer">Envoyer</button>
            <p class="statut" aria-live="polite"></p>
          </form>
          <div class="reseaux">
            {site.social.map((s) => ICONS[s.id] && (
              <a href={s.url} target="_blank" rel="noopener noreferrer" title={s.label} aria-label={s.label}>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" set:html={ICONS[s.id]}></svg>
              </a>
            ))}
          </div>
          <div class="coordonnees">
            <a href={`mailto:${site.email}`}>{site.email}</a>
            <p class="iban">{site.iban}</p>
          </div>
        </div>
      </div>
    </div>
  </Page>
</Base>
<script>
  /* Traits gardés en mémoire ({color, pts}) et rejoués : le dessin survit au resize (sans flou)
     et à la bascule de thème (l'encre suit --fg). */
  const INKS: Record<string, string> = { orange: "#FF6B00", rose: "#FF2D95", vert: "#39FF14", jaune: "#FFE800", bleu: "#00CFFF" };
  const LINE_WIDTH = 2.5;
  // Netlify limite toute la requête à 8 Mo : deux millions de pixels gardent le trait net avec une marge sûre.
  const MAX_EXPORT_PIXELS = 2_000_000;
  type Stroke = { color: string; pts: { x: number; y: number }[] };

  let canvas: HTMLCanvasElement | null = null;
  let strokes: Stroke[] = [];
  let ink = "ink";

  const resolve = (id: string) =>
    id === "ink" ? getComputedStyle(document.documentElement).getPropertyValue("--fg").trim() || "#000" : INKS[id] || id;

  function redraw() {
    if (!canvas) return;
    const dpr = window.devicePixelRatio || 1;
    const rect = canvas.getBoundingClientRect();
    canvas.width = Math.round(rect.width * dpr);
    canvas.height = Math.round(rect.height * dpr);
    const ctx = canvas.getContext("2d")!;
    ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
    ctx.clearRect(0, 0, rect.width, rect.height);
    ctx.lineWidth = LINE_WIDTH; ctx.lineCap = "round"; ctx.lineJoin = "round";
    for (const s of strokes) {
      if (s.pts.length < 2) continue;
      ctx.strokeStyle = resolve(s.color);
      ctx.beginPath();
      ctx.moveTo(s.pts[0].x, s.pts[0].y);
      s.pts.slice(1).forEach((p) => ctx.lineTo(p.x, p.y));
      ctx.stroke();
    }
  }

  function toBlob(): Promise<Blob | null> {
    return new Promise((done) => {
      if (!strokes.length || !canvas) return done(null);
      const dpr = window.devicePixelRatio || 1;
      const rect = canvas.getBoundingClientRect();
      const scale = Math.min(dpr, Math.sqrt(MAX_EXPORT_PIXELS / (rect.width * rect.height)));
      const out = document.createElement("canvas");
      out.width = Math.max(1, Math.round(rect.width * scale));
      out.height = Math.max(1, Math.round(rect.height * scale));
      const ctx = out.getContext("2d")!;
      ctx.fillStyle = "#FAFAF8";
      ctx.fillRect(0, 0, out.width, out.height);
      ctx.setTransform(scale, 0, 0, scale, 0, 0);
      ctx.lineWidth = LINE_WIDTH; ctx.lineCap = "round"; ctx.lineJoin = "round";
      for (const s of strokes) {
        if (s.pts.length < 2) continue;
        ctx.strokeStyle = s.color === "ink" ? "#1A1A1A" : INKS[s.color] || s.color;
        ctx.beginPath();
        ctx.moveTo(s.pts[0].x, s.pts[0].y);
        s.pts.slice(1).forEach((p) => ctx.lineTo(p.x, p.y));
        ctx.stroke();
      }
      out.toBlob(done, "image/png");
    });
  }

  function init() {
    canvas = document.getElementById("dessin-canvas") as HTMLCanvasElement | null;
    if (!canvas) return;
    strokes = []; ink = "ink";
    const c = canvas;
    let drawing = false;
    const pos = (e: MouseEvent | TouchEvent) => {
      const r = c.getBoundingClientRect();
      const p = "touches" in e ? e.touches[0] : e;
      return { x: p.clientX - r.left, y: p.clientY - r.top };
    };
    const start = (e: MouseEvent | TouchEvent) => {
      drawing = true;
      const { x, y } = pos(e);
      strokes.push({ color: ink, pts: [{ x, y }] });
      const ctx = c.getContext("2d")!;
      ctx.strokeStyle = resolve(ink);
      ctx.lineWidth = LINE_WIDTH; ctx.lineCap = "round"; ctx.lineJoin = "round";
      ctx.beginPath(); ctx.moveTo(x, y);
    };
    const move = (e: MouseEvent | TouchEvent) => {
      if (!drawing) return;
      e.preventDefault();
      const { x, y } = pos(e);
      strokes[strokes.length - 1].pts.push({ x, y });
      const ctx = c.getContext("2d")!;
      ctx.lineTo(x, y); ctx.stroke();
    };
    const end = () => { drawing = false; };
    c.addEventListener("mousedown", start); c.addEventListener("mousemove", move);
    c.addEventListener("mouseup", end); c.addEventListener("mouseleave", end);
    c.addEventListener("touchstart", start, { passive: true });
    c.addEventListener("touchmove", move, { passive: false });
    c.addEventListener("touchend", end);
    // Après la mise en page : le canvas prend sa taille réelle (et --fg du thème courant).
    requestAnimationFrame(redraw);

    const clear = () => { strokes = []; redraw(); };
    document.getElementById("dessin-effacer")!.addEventListener("click", clear);
    document.querySelectorAll<HTMLElement>("[data-ink]").forEach((b) =>
      b.addEventListener("click", () => {
        ink = b.dataset.ink!;
        document.querySelectorAll("[data-ink]").forEach((o) => o.toggleAttribute("data-active", o === b));
      }));

    const form = document.forms.namedItem("contact")!;
    const button = form.querySelector<HTMLButtonElement>(".envoyer")!;
    const statut = form.querySelector<HTMLElement>(".statut")!;
    form.addEventListener("submit", async (event) => {
      event.preventDefault();
      if (button.disabled) return;
      button.disabled = true; button.textContent = "Envoi…";
      statut.textContent = ""; statut.removeAttribute("data-error");
      try {
        const formData = new FormData(form);
        formData.delete("dessin"); // le champ fichier vide ne part pas : seul le PNG dessiné
        const drawing = await toBlob();
        if (drawing) formData.append("dessin", drawing, `dessin-${Date.now()}.png`);
        const response = await fetch("/", { method: "POST", body: formData });
        if (!response.ok) throw new Error(`Netlify Forms: ${response.status}`);
        form.reset();
        clear();
        statut.textContent = "Merci, votre message et votre dessin ont bien été envoyés.";
      } catch (error) {
        console.error("Échec de l’envoi du formulaire", error);
        statut.textContent = "L’envoi a échoué. Votre dessin est conservé : vous pouvez réessayer.";
        statut.setAttribute("data-error", "");
      } finally {
        button.disabled = false; button.textContent = "Envoyer";
      }
    });
  }

  // Posés une fois : le canvas du moment (s'il y en a un) est redessiné.
  window.addEventListener("resize", redraw);
  new MutationObserver(() => requestAnimationFrame(redraw)).observe(document.documentElement, { attributes: true, attributeFilter: ["data-theme"] });
  document.addEventListener("astro:page-load", init);
</script>
<style>
  .grille { display: grid; grid-template-columns: 1fr 1fr; min-height: calc(100vh - var(--header-h)); }
  .dessin { position: relative; order: 1; height: calc(100vh - var(--header-h)); border-right: 1px solid var(--border); }
  canvas { width: 100%; height: 100%; cursor: crosshair; touch-action: none; display: block; }
  .barre {
    position: absolute; left: 0; right: 0; top: 0; pointer-events: none;
    display: flex; align-items: center; justify-content: space-between; gap: 16px;
    padding: 18px clamp(16px, 3vw, 32px);
  }
  .encres { display: flex; align-items: center; gap: 12px; pointer-events: auto; }
  .encres button {
    width: 22px; height: 22px; border-radius: 50%; cursor: pointer; padding: 0; border: none;
    outline: none; outline-offset: 3px; transition: transform 0.2s;
  }
  .encres button[data-ink="ink"] { border: 1px solid var(--fg-subtle); }
  .encres button[data-active] { outline: 1px solid var(--fg); transform: scale(1.12); }
  .effacer {
    pointer-events: auto; background: none; border: none; cursor: pointer; color: var(--fg-muted);
    font-size: 12px; font-family: var(--font-body); letter-spacing: 0.08em; transition: color 0.2s;
  }
  .effacer:hover { color: var(--fg); }

  .formulaire {
    order: 2; display: flex; flex-direction: column; justify-content: center;
    padding: clamp(32px, 6vh, 64px) var(--container-pad) clamp(40px, 8vh, 72px);
  }
  .colonne { width: 100%; max-width: 460px; margin: 0 auto; }
  form { display: flex; flex-direction: column; gap: 18px; }
  form label { font-size: 14px; color: var(--fg-muted); }
  form input:not([type="hidden"]), form textarea {
    display: block; width: 100%; padding: 10px 12px; background: transparent; border: 1px solid var(--border);
    color: var(--fg); font-family: var(--font-body); font-size: 15px; margin-top: 6px;
  }
  textarea { resize: vertical; }
  .envoyer {
    align-self: flex-start; background: var(--fg); color: var(--bg); border: none; min-height: 44px;
    padding: 10px 26px; cursor: pointer; font-family: var(--font-body); font-size: 14px; letter-spacing: 0.04em;
  }
  .envoyer:disabled { cursor: wait; opacity: 0.6; }
  .statut { min-height: 24px; font-size: 14px; color: var(--fg-muted); }
  .statut[data-error] { color: #b42318; }
  .reseaux { display: flex; align-items: center; gap: 14px; margin-top: var(--block-gap); }
  .reseaux a { color: var(--fg); opacity: 0.5; line-height: 0; transition: opacity 0.25s; }
  .reseaux a:hover { opacity: 1; }
  .coordonnees { margin-top: 16px; font-size: 15px; color: var(--fg-muted); line-height: 1.7; }
  .coordonnees a { text-underline-offset: 0.18em; }
  .iban { margin-top: 8px; color: var(--fg); font-family: var(--font-digital); font-size: 14px; letter-spacing: 0.04em; }

  @media (max-width: 760px) {
    .grille { grid-template-columns: 1fr; min-height: 0; }
    .dessin { order: 2; height: 60vh; border-right: none; border-top: 1px solid var(--border); }
    .formulaire { order: 1; padding-top: clamp(40px, 8vh, 72px); }
  }
</style>
