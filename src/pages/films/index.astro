---
import { getCollection } from "astro:content";
import Base from "../../layouts/Base.astro";
import Header from "../../components/Header.astro";
import Page from "../../components/Page.astro";
import BackLink from "../../components/BackLink.astro";
import Popup from "../../components/Popup.astro";

const albums = await getCollection("albums");
---
<Base title="Films pour les oreilles — Vania Jaikin Miyazaki" path="/films">
  <Header />
  <Page>
    <BackLink href="/menu" />
    <div class="liste">
      {albums.map((a, i) => (
        <div class="ligne">
          <a href={`/films/${a.id}`} class="titre">{a.data.titre}</a>
          {a.data.resume && (
            <button type="button" data-album-info={a.id} aria-label={`Infos — ${a.data.titre}`} title="Infos">
              <img src={`/assets/brand/info-album-${Math.min(i + 1, 3)}.svg`} alt="" aria-hidden="true" />
            </button>
          )}
        </div>
      ))}
    </div>
  </Page>
  {albums.map((a, i) => a.data.resume && (
    <Popup id={`popup-album-${a.id}`} seed={i + 2} label={a.data.titre}>
      <p class="vjm-popup-title">{a.data.titre}</p>
      <p style="font-family:var(--font-body);font-size:17px;line-height:1.7;opacity:0.92">{a.data.resume}</p>
    </Popup>
  ))}
</Base>
<style>
  .liste { border-top: 1px solid var(--border); }
  .ligne {
    display: flex; align-items: center; justify-content: space-between; gap: 24px;
    padding: clamp(30px, 4vw, 52px) 0; border-bottom: 1px solid var(--border);
  }
  .titre {
    color: var(--fg); font-family: var(--font-heading); font-size: clamp(1.1rem, 1.8vw, 1.45rem);
    text-decoration: none; transition: opacity 0.2s; opacity: 0.9; line-height: 1.25;
  }
  .titre:hover { opacity: 1; }
  button {
    background: none; border: none; color: var(--fg-muted); width: 44px; height: 44px; cursor: pointer;
    flex-shrink: 0; display: flex; align-items: center; justify-content: center;
    transition: opacity 0.2s; opacity: 0.62;
  }
  button:hover { opacity: 1; }
  img { width: 28px; height: 28px; object-fit: contain; display: block; filter: var(--ink-invert); }
</style>
