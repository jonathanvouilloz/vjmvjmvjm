---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Sigle from "../components/Sigle.astro";
import DotField from "../islands/DotField.jsx";
import { SECTIONS_MENU } from "../lib/sigles";
import { abs } from "../lib/seo";
---
<Base title="Menu — Vania Jaikin Miyazaki" path="/menu" ld={{
  "@type": "BreadcrumbList",
  itemListElement: [{ "@type": "ListItem", position: 1, name: "Accueil", item: abs("/") }, { "@type": "ListItem", position: 2, name: "Menu", item: abs("/menu") }],
}}>
  <Header />
  <DotField client:load />
  <main>
    {SECTIONS_MENU.map((s) => (
      <a class="section" href={`/${s.id}`}>
        <Sigle id={s.id} flip />
        {s.label}
        <Sigle id={s.id} />
      </a>
    ))}
    <div class="secondaires">
      <a href="/contact">contact</a>
      <span aria-hidden="true">·</span>
      <a href="/bio">bio</a>
    </div>
  </main>
</Base>

<style>
  main {
    position: relative; z-index: 1; min-height: 100vh;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 30px;
    animation: apparition 0.8s ease 0.1s both;
  }
  .section {
    color: var(--fg); text-decoration: none; opacity: 0.8; white-space: nowrap;
    font-family: var(--font-menu); font-weight: 400; font-size: clamp(1.3rem, 3.2vw, 2rem);
    letter-spacing: 0.04em; display: flex; align-items: center; gap: 18px;
    transition: opacity 0.4s ease, letter-spacing 0.25s;
  }
  .section:hover { opacity: 1; letter-spacing: 0.09em; }
  .secondaires { display: flex; align-items: center; gap: 18px; margin-top: var(--block-gap); }
  .secondaires a {
    color: var(--fg-muted); text-decoration: none; font-family: var(--font-body);
    font-size: 17px; letter-spacing: 0.07em; transition: color 0.25s;
  }
  .secondaires a:hover { color: var(--fg); }
  .secondaires span { color: var(--fg-subtle); font-size: 16px; }
  @keyframes apparition { from { opacity: 0; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { main { animation: none; } }
</style>
