---
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Sigle from "../components/Sigle.astro";
import DotField from "../islands/DotField.jsx";
import { SECTIONS_MENU } from "../lib/sigles";
import { abs } from "../lib/seo";
import { getCollection } from "astro:content";
import { renderMarkdown } from "../lib/content";
import { image, withImageVariants } from "../lib/images";

// toutes les news publiées sous le pli : la plus récente et celles « gardées en grand » en haut,
// les autres en vignettes qui s'ouvrent au clic
const articles = (await getCollection("articles", (a) => a.data.publie))
  .sort((a, b) => b.data.date.localeCompare(a.data.date) || Number(b.data.enGrand) - Number(a.data.enGrand));
const article = articles[0];
const grandes = articles.filter((a, i) => i === 0 || a.data.enGrand);
const petites = articles.filter((a) => !grandes.includes(a));
const corps = (a: (typeof articles)[number]) => withImageVariants(renderMarkdown(a.data.corps));
const dateFr = (d: string) => new Date(`${d.slice(0, 10)}T12:00:00Z`).toLocaleDateString("fr-CH", { day: "numeric", month: "long", year: "numeric" });
---
<Base title="Menu — Vania Jaikin Miyazaki" path="/menu" ld={{
  "@type": "BreadcrumbList",
  itemListElement: [{ "@type": "ListItem", position: 1, name: "Accueil", item: abs("/") }, { "@type": "ListItem", position: 2, name: "Menu", item: abs("/menu") }],
}}>
  <Header />
  <main class:list={{ "avec-news": article }}>
    <DotField client:load />
    {SECTIONS_MENU.map((s) => (
      <a class="section" href={`/${s.id}`}>
        <Sigle id={s.id} flip />
        {s.label}
        <Sigle id={s.id} />
      </a>
    ))}
    <div class="secondaires">
      <a href="/contact">contact</a>
      <span aria-hidden="true">·</span>
      <a href="/bio">bio</a>
    </div>
    {article && (
      <a class="defiler" href="#news" aria-label="dernière news">
        <img src="/assets/brand/news-scroll.svg" width="630" height="349" alt="" />
      </a>
    )}
  </main>
  {article && (
    <section id="news" class="news">
      {grandes.map((a) => {
        const cover = a.data.image ? image(a.data.image) : null;
        return (
          <article>
            <p class="news-date"><time datetime={a.data.date}>{dateFr(a.data.date)}</time></p>
            <h2>{a.data.titre}</h2>
            {cover && <img class="news-image" src={cover.src} width={cover.w} height={cover.h} alt="" loading="lazy" />}
            <div class="vjm-prose" set:html={corps(a)} />
          </article>
        );
      })}
      {petites.length > 0 && (
        <div class="petites">
          {petites.map((a) => {
            const cover = a.data.image ? image(a.data.image) : null;
            const html = corps(a);
            return (
              <details class="petite">
                <summary>
                  {cover && <img class="petite-image" src={cover.src} width={cover.w} height={cover.h} alt="" loading="lazy" />}
                  <p class="news-date"><time datetime={a.data.date}>{dateFr(a.data.date)}</time></p>
                  <h3>{a.data.titre}</h3>
                  {/* début du texte, sans liens : rien de cliquable dans le résumé */}
                  <p class="extrait" set:html={html.replace(/<[^>]+>/g, " ")} />
                </summary>
                {cover && <img class="news-image" src={cover.src} width={cover.w} height={cover.h} alt="" loading="lazy" />}
                <div class="vjm-prose" set:html={html} />
              </details>
            );
          })}
        </div>
      )}
    </section>
  )}
</Base>

<style>
  main {
    position: relative; z-index: 1; min-height: 100vh;
    display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 30px;
    animation: apparition 0.8s ease 0.1s both;
  }
  .section {
    color: var(--fg); text-decoration: none; opacity: 0.8; white-space: nowrap;
    font-family: var(--font-menu); font-weight: 400; font-size: clamp(1.3rem, 3.2vw, 2rem);
    letter-spacing: 0.04em; display: flex; align-items: center; gap: 18px;
    transition: opacity 0.4s ease, letter-spacing 0.25s;
  }
  .section:hover { opacity: 1; letter-spacing: 0.09em; }
  .secondaires { display: flex; align-items: center; gap: 18px; margin-top: var(--block-gap); }
  .secondaires a {
    color: var(--fg-muted); text-decoration: none; font-family: var(--font-body);
    font-size: 17px; letter-spacing: 0.07em; transition: color 0.25s;
  }
  .secondaires a:hover { color: var(--fg); }
  .secondaires span { color: var(--fg-subtle); font-size: 16px; }
  /* avec une news : le menu laisse 10 % de l'écran pour annoncer la suite */
  main.avec-news { min-height: 90vh; min-height: 90svh; }
  .defiler {
    position: absolute; bottom: 18px; left: 50%; transform: translateX(-50%);
    opacity: 0.75; transition: opacity 0.25s;
  }
  .defiler:hover { opacity: 1; }
  .defiler img { display: block; width: clamp(96px, 12vw, 140px); height: auto; filter: var(--ink-invert); animation: descente 2.2s ease-in-out infinite; }
  @keyframes descente { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(6px); } }
  .news {
    position: relative; z-index: 1; max-width: 720px; margin: 0 auto;
    padding: clamp(48px, 10vh, 120px) var(--container-pad) var(--page-bottom);
  }
  .news article + article { margin-top: clamp(64px, 12vh, 140px); }
  .news-date { font-family: var(--font-digital); font-size: 13px; letter-spacing: 0.08em; color: var(--fg-muted); text-transform: uppercase; }
  .news h2 {
    font-family: var(--font-heading); font-weight: var(--heading-weight); letter-spacing: var(--heading-spacing);
    font-size: clamp(1.8rem, 4vw, 2.6rem); line-height: 1.15; margin: 12px 0 var(--block-gap);
  }
  .news-image { display: block; width: 100%; height: auto; margin-bottom: var(--block-gap); }
  /* anciennes news : 3 vignettes par ligne ; une vignette ouverte prend toute la ligne */
  .petites {
    display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 190px), 1fr)); gap: 40px 28px;
    margin-top: clamp(64px, 12vh, 140px);
  }
  .petite summary { list-style: none; cursor: pointer; opacity: 0.85; transition: opacity 0.25s; }
  .petite summary::-webkit-details-marker { display: none; }
  .petite summary:hover { opacity: 1; }
  .petite summary:focus-visible { outline: 1px solid var(--fg-muted); outline-offset: 6px; }
  .petite-image { display: block; width: 100%; aspect-ratio: 4 / 3; object-fit: cover; margin-bottom: 10px; }
  .petite h3 {
    font-family: var(--font-heading); font-weight: var(--heading-weight); letter-spacing: var(--heading-spacing);
    font-size: 1.15rem; line-height: 1.25; margin: 6px 0;
  }
  .extrait {
    font-size: 15px; color: var(--fg-muted); margin: 0;
    display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;
  }
  .petite[open] { grid-column: 1 / -1; }
  .petite[open] .petite-image, .petite[open] .extrait { display: none; }
  .petite[open] h3 { font-size: clamp(1.8rem, 4vw, 2.6rem); line-height: 1.15; margin: 12px 0 var(--block-gap); }
  @keyframes apparition { from { opacity: 0; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { main, .defiler img { animation: none; } }
</style>
